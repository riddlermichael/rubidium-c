Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  clazy-*,
  concurrency-*,
  cppcoreguidelines-*,
  google-*,
  llvm-namespace-comment,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -cert-err58-cpp,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clazy-function-args-by-ref,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-avoid-magic-numbers,
  -misc-include-cleaner,
  -misc-use-anonymous-namespace,
  -readability-avoid-nested-conditional-operator,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-use-concise-preprocessor-directives,

FormatStyle: file
CheckOptions:
  #  - { key: readability-identifier-naming.EnumPrefix, value: Rbc }
  #  - { key: readability-identifier-naming.StructPrefix, value: Rbc }
  #  - { key: readability-identifier-naming.TypedefPrefix, value: Rbc }
  - { key: readability-identifier-naming.ConstantCase, value: UPPER_CASE }
  - { key: readability-identifier-naming.ConstantPrefix, value: RBC_ }
  - { key: readability-identifier-naming.EnumCase, value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantCase, value: UPPER_CASE }
  - { key: readability-identifier-naming.EnumConstantPrefix, value: RBC_ }
  - { key: readability-identifier-naming.GlobalConstantCase, value: UPPER_CASE }
  - { key: readability-identifier-naming.GlobalConstantPrefix, value: RBC_ }
  - { key: readability-identifier-naming.LocalConstantCase, value: lower_case }
  - { key: readability-identifier-naming.MacroDefinitionCase, value: UPPER_CASE }
  - { key: readability-identifier-naming.MacroDefinitionPrefix, value: RBC_ }
  - { key: readability-identifier-naming.StaticConstantCase, value: UPPER_CASE }
  - { key: readability-identifier-naming.StaticConstantPrefix, value: RBC_ }
  - { key: readability-identifier-naming.StructCase, value: CamelCase }
  - { key: readability-identifier-naming.TypedefCase, value: CamelCase }
  - { key: readability-identifier-naming.UnionCase, value: CamelCase }
  - { key: readability-identifier-naming.VariableCase, value: lower_case }
  - { key: bugprone-signed-bitwise.IgnorePositiveIntegerLiterals, value: 1 }
